# Copy to .env. Never commit .env.
ANTHROPIC_API_KEY=
ETHERSCAN_API_KEY=                 # optional: Etherscan v2 fallback when Sourcify has no match
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com   # chain the registry lives on (cli/ uses this)
DEPLOYER_PRIVATE_KEY=              # pays for deploy / registerSigner / submitAudit / keeper txs
DEPLOYER_ADDRESS=

# Filled in after `forge script script/Deploy.s.sol` (cli/*.py and the auditor read these)
REGISTRY_ADDRESS=
REGISTRY_CHAIN_ID=11155111
REGISTRY_DEPLOY_BLOCK=             # first block to scan for registry events
AUDITOR_URL=http://127.0.0.1:8080
RPC_URL_1=https://ethereum-rpc.publicnode.com   # per-chain RPCs for verify_audit / export_snapshot code-hash checks

# Auditor only
# MOCK_TEE=1                       # sign attestations with auditor/dev_rsa_key.pem instead of Confidential Space
# AUDITOR_MODEL=claude-fable-5-1   # part of τ; changing it changes configHash
# RPC_URLS_JSON={"11155111":"https://..."}   # part of τ; defaults in auditor/config.py
